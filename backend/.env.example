# Copy this file to backend/.env and fill it in. backend/.env is ignored by git; never commit real secrets.
DATABASE_URL=postgresql+psycopg://sarathi:CHANGE_ME@localhost:5432/sarathi

# Signs login tokens. Generate one with:
#   ..\.venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# console prints verification and reset codes to the server log (development);
# smtp sends real emails and needs the SMTP_* settings below.
EMAIL_BACKEND=console
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Sarathi <no-reply@sarathi.app>

# The session cookie is HTTPS-only by default (browsers allow it on http://localhost too). Set COOKIE_SECURE=false
# only to test from another device over plain http on your network, e.g. a phone opening http://192.168.x.x:5173.
# COOKIE_SECURE=true

# Optional: ACCESS_TOKEN_MINUTES=30, REFRESH_TOKEN_DAYS=30, CORS_ORIGINS=http://localhost:5173
