# Copy to frontend/.env.local to change these; none are needed for local development.

# API location, if it isn't served from the same address as the app (e.g. https://api.example.com).
# VITE_API_URL=

# Map tiles (Stadia "OSM Bright", English labels). Free key from https://client.stadiamaps.com, needed once the
# app runs on a real domain (or register the domain there instead). Not needed on localhost.
# VITE_STADIA_API_KEY=

# Replace the map style entirely (Leaflet tile URL template) and its credit line.
# VITE_MAP_TILES_URL=
# VITE_MAP_ATTRIBUTION=
