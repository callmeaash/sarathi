# Copy to frontend/.env.local to change these; none are needed for local development.

# API location, if it isn't served from the same address as the app (e.g. https://api.example.com).
# VITE_API_URL=

# Map tiles: OpenStreetMap's own by default. To switch style, set a Leaflet tile URL template and its credit
# line, e.g. Stadia's English-labelled OSM Bright (free key from https://client.stadiamaps.com for a real domain):
# VITE_MAP_TILES_URL=https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
# VITE_MAP_TILES_URL=
# VITE_MAP_ATTRIBUTION=
